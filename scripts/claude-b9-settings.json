{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)", "Bash(git diff *)", "Bash(git --no-pager diff *)",
      "Bash(git log *)", "Bash(git --no-pager log *)", "Bash(git grep *)",
      "Bash(git ls-files *)", "Bash(git show *)", "Bash(git --no-pager show *)",
      "Bash(uv run pytest *)",
      "Bash(powershell -NoProfile -File scripts/check.ps1 *)",
      "PowerShell(git status *)", "PowerShell(git diff *)", "PowerShell(git --no-pager diff *)",
      "PowerShell(git log *)", "PowerShell(git --no-pager log *)", "PowerShell(git grep *)",
      "PowerShell(git ls-files *)", "PowerShell(git show *)", "PowerShell(git --no-pager show *)",
      "PowerShell(uv run pytest *)",
      "PowerShell(.\\scripts\\check.ps1 *)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Read(./.dev.vars)",
      "Read(./.env)",
      "Bash(git *--output*)",
      "Bash(git *--open-files-in-pager*)",
      "Bash(git grep *-O*)",
      "PowerShell(git *--output*)",
      "PowerShell(git *--open-files-in-pager*)",
      "PowerShell(git grep *-O*)",
      "Bash(git *--op*)",
      "Bash(git *--no-ind*)",
      "Bash(git *--no-exc*)",
      "PowerShell(git *--op*)",
      "PowerShell(git *--no-ind*)",
      "PowerShell(git *--no-exc*)",
      "Bash(uv run pytest *--basetemp*)",
      "Bash(uv run pytest *--junit*)",
      "Bash(uv run pytest *--log-file*)",
      "Bash(uv run pytest *--debug*)",
      "Bash(uv run pytest *--override-ini*)",
      "Bash(uv run pytest * -o*)",
      "Bash(uv run pytest * -p*)",
      "PowerShell(uv run pytest *--basetemp*)",
      "PowerShell(uv run pytest *--junit*)",
      "PowerShell(uv run pytest *--log-file*)",
      "PowerShell(uv run pytest *--debug*)",
      "PowerShell(uv run pytest *--override-ini*)",
      "PowerShell(uv run pytest * -o*)",
      "PowerShell(uv run pytest * -p*)"
    ]
  }
}
