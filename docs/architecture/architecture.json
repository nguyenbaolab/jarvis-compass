  "cards": [
    {
      "dot": "cyan",
      "title": "Layering",
      "items": [
        "src/core imports the standard library and other core modules. check.ps1 lines 423-425 forbid fastapi, pydantic, tools, and db there.",
        "The Anthropic SDK is imported only in src/clients/anthropic_model.py.",
        "workers is imported only in src/entry.py.",
        "postgrest is imported only in src/db/client.py."
      ]
    },
    {
      "dot": "emerald",
      "title": "Telegram channel",
      "items": [
        "Each update is claimed before it is handled.",
        "decide_receive returns Done, Resend, Defer, or SaveUncertain.",
        "The reply is saved, context is written, then each part is sent.",
        "Outbound text is split at 4096 UTF-16 units.",
        "A claim older than 90 seconds is dead."
      ]
    },
    {
      "dot": "amber",
      "title": "Morning digest",
      "items": [
        "Three crons fire at 05:00, 06:00, and 07:00 UTC.",
        "Before 08:00 Helsinki the run only logs before_eight.",
        "One row per Helsinki day uses a negative update_id.",
        "The morning path does not call the model."
      ]
    },
    {
      "dot": "violet",
      "title": "Model turn",
      "items": [
        "A turn has a 20 second budget and at most three tool rounds.",
        "replace_plan writes only when version matches, then increments it.",
        "An abnormal end after a save returns the composed saved lines."
      ]
    },
    {
      "dot": "orange",
      "title": "Load check",
      "items": [
        "Code computes the day load and proposes moves.",
        "The first call does not write. A write waits for confirm on a later turn.",
        "Each move goes through replace_plan and leaves an append-only history row."
      ]
    },
    {
      "dot": "rose",
      "title": "Persistence",
      "items": [
        "Plan writes and all Telegram channel state use seven RPCs: add_plan, replace_plan, claim_telegram_update, save_telegram_reply, mark_telegram_sent, append_telegram_context, and list_telegram_context.",
        "Plan reads are two selects on plans with its subtasks: list_plans and get_plan.",
        "All five tables enable RLS. Migrations revoke table and function rights from public, anon, and authenticated.",
        "subtask_date_moves is append-only: a trigger blocks update and delete."
      ]
    }
  ]
}
